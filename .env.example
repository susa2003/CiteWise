# Backend
CITEWISE_ENVIRONMENT=development
CITEWISE_DATABASE_URL=sqlite:///storage/citewise.db
CITEWISE_STORAGE_DIR=storage
CITEWISE_MAX_UPLOAD_MB=50
CITEWISE_CORS_ORIGINS=http://localhost:5173

# AI mode: demo keeps extraction and keyword search available without an LLM.
CITEWISE_LLM_PROVIDER=none
CITEWISE_LLM_API_KEY=
CITEWISE_LLM_MODEL=
CITEWISE_LLM_BASE_URL=https://api.openai.com/v1
CITEWISE_EMBEDDING_PROVIDER=none
CITEWISE_EMBEDDING_MODEL=
CITEWISE_OCR_ENABLED=false
